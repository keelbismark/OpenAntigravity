[ -f "OpenAntigravity_windows_v1.1.4.zip" ] && cp "OpenAntigravity_windows_v1.1.4.zip" "OpenAntigravity-windows-portable.zip"
[ -f "OpenAntigravity_linux_v1.1.4.tar.gz" ] && cp "OpenAntigravity_linux_v1.1.4.tar.gz" "OpenAntigravity-linux-portable.tar.gz"

sha256sum OpenAntigravity*.zip OpenAntigravity*.tar.gz OpenAntigravity*.AppImage > SHA256SUMS.txt 2>/dev/null || true

# Сбор списка изменений из Conventional Commits
